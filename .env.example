# Python does not automatically load this file. Set actual environment variables.
HOST=127.0.0.1
PORT=5000
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# Exact deployed Vercel origin; no trailing slash, no wildcard.
FRONTEND_ORIGINS=https://your-project.vercel.app
# Optional; leave unset for local public-feed and model checks only.
# WEB_RISK_API_KEY=
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
# For a verified release, set both paths together.
# MODEL_PATH=release/current/runtime-model.joblib
# EVALUATION_PATH=release/current/evaluation.json
# MODEL_MMAP=1
# Optional extra artifact verification before loading trusted joblib data.
# MODEL_SHA256=
# Commercial deployment uses the MIT source; OpenPhish Community is academic only.
# PUBLIC_FEED_KEYS=phishing_database
# Render build: trusted release archive location and checksum from release.py build.
# RELEASE_URL=https://your-private-artifact-host/release.zip
# RELEASE_SHA256=
